#!/usr/bin/env bash
# Start the installer session inside cage (a single-window Wayland kiosk).
# Falls back to software rendering when there is no usable GPU, which is
# common in VMs and with the "safe graphics" (nomodeset) boot entry.

export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export XCURSOR_SIZE=24
export WLR_NO_HARDWARE_CURSORS=1

log=/tmp/vinos-installer.log

cage -s -d -- vinos-session >"$log" 2>&1 && exit 0

echo "cage exited with an error, retrying with software rendering" >>"$log"
export WLR_RENDERER=pixman
export QT_QUICK_BACKEND=software
exec cage -s -d -- vinos-session >>"$log" 2>&1
