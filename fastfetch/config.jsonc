// vinOS fastfetch defaults. Installed to /etc/xdg/fastfetch/config.jsonc so
// every user gets it; copy to ~/.config/fastfetch/config.jsonc to customise.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/vinos/fastfetch/vinos.txt",
    "color": {
      "1": "38;2;239;232;220",
      "2": "38;2;184;80;94"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;184;80;94",
      "title": "38;2;239;232;220",
      "output": "38;2;201;192;179"
    },
    "key": { "width": 9 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;94;84;75m──────────────────────────────" },
    { "type": "os", "key": "os", "format": "vinOS {arch}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
